rules_version = '2';

// Sawa — Cloud Firestore security rules.
// Paste these into: Firebase console → Firestore Database → Rules → Publish.
//
// Each signed-in user can read and write ONLY their own profile
// document and their own chats document. Nobody else can touch them.
service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid} — the user's profile (name, email, phone)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // chats/{uid} — the user's conversations + messages
    match /chats/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is denied by default.
  }
}
